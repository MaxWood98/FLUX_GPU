#flux flow solver options file 
#version 0.0.2

#console display output
console_display = yes

#mesh path 
meshpath = grid_cell_naca

#flow conditions 
aoadeg = 10.0
machinf = 0.5
gamma = 1.4
R = 287.058
tinf = 288.0
rhoinf = 1.225
outflow_pratio = 0.0

#solver options 
niter_max = 10
cfl = 2.0
k2 = 0.0001 
k4 = 0.0001
flux_method = ausm+up
num_threads = 16
residual_convtol = -8.0 

#Runge-Kutta stage dissipation evaluation tags 1 2 3 4
RKstagediss_eval = 1 0 0 0

#Adjoint options 
adjoint_objective = cd
